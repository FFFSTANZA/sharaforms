# ---------- Stage 1: dependencies ----------
FROM node:24-alpine AS deps

WORKDIR /app

RUN apk add --no-cache git

COPY ./client/package.json ./client/package-lock.json ./
RUN npm ci --no-audit --no-fund && \
    npm cache clean --force

# ---------- Stage 2: build ----------
FROM node:24-alpine AS build

WORKDIR /app

RUN apk add --no-cache git

# Public + private runtime config values are baked into the client bundle at
# build time. Supply them from the real client/.env when building:
#   docker build -t sharaforms/ui:latest \
#     $(for k in $(grep -oE '^[A-Z_]+=' client/.env | tr -d '='); do \
#         printf -- '--build-arg %s=%s ' "$k" "$(grep -m1 -E "^${k}=" client/.env | cut -d= -f2- | tr -d '\r')"; \
#       done) \
#     -f docker/Dockerfile.client .
ARG NUXT_PUBLIC_APP_URL=
ARG NUXT_PUBLIC_API_BASE=
ARG NUXT_PRIVATE_API_BASE=
ARG NUXT_PUBLIC_ENV=
ARG NUXT_API_SECRET=
ARG NUXT_PUBLIC_LICENSE_API_ENDPOINT=
ARG NUXT_PUBLIC_H_CAPTCHA_SITE_KEY=
ARG NUXT_PUBLIC_RE_CAPTCHA_SITE_KEY=
ARG NUXT_PUBLIC_ROOT_REDIRECT_URL=
ARG NUXT_PUBLIC_PRIVACY_POLICY_PAGE_ID=
ARG NUXT_PUBLIC_TERMS_CONDITIONS_PAGE_ID=
ARG NUXT_PUBLIC_GOOGLE_ANALYTICS_CODE=

ENV NUXT_PUBLIC_APP_URL=$NUXT_PUBLIC_APP_URL \
    NUXT_PUBLIC_API_BASE=$NUXT_PUBLIC_API_BASE \
    NUXT_PRIVATE_API_BASE=$NUXT_PRIVATE_API_BASE \
    NUXT_PUBLIC_ENV=$NUXT_PUBLIC_ENV \
    NUXT_API_SECRET=$NUXT_API_SECRET \
    NUXT_PUBLIC_LICENSE_API_ENDPOINT=$NUXT_PUBLIC_LICENSE_API_ENDPOINT \
    NUXT_PUBLIC_H_CAPTCHA_SITE_KEY=$NUXT_PUBLIC_H_CAPTCHA_SITE_KEY \
    NUXT_PUBLIC_RE_CAPTCHA_SITE_KEY=$NUXT_PUBLIC_RE_CAPTCHA_SITE_KEY \
    NUXT_PUBLIC_ROOT_REDIRECT_URL=$NUXT_PUBLIC_ROOT_REDIRECT_URL \
    NUXT_PUBLIC_PRIVACY_POLICY_PAGE_ID=$NUXT_PUBLIC_PRIVACY_POLICY_PAGE_ID \
    NUXT_PUBLIC_TERMS_CONDITIONS_PAGE_ID=$NUXT_PUBLIC_TERMS_CONDITIONS_PAGE_ID \
    NUXT_PUBLIC_GOOGLE_ANALYTICS_CODE=$NUXT_PUBLIC_GOOGLE_ANALYTICS_CODE

COPY --from=deps /app/node_modules ./node_modules
COPY ./client/ ./

RUN npm run build && \
    npm cache clean --force

# ---------- Stage 3: runtime ----------
FROM node:24-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NITRO_HOST=0.0.0.0 \
    NITRO_PORT=3000

COPY --from=build /app/.output ./.output

EXPOSE 3000

USER node

CMD ["node", ".output/server/index.mjs"]

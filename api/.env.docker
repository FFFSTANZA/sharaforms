APP_NAME="SharaForms"
APP_ENV=production
# This file is meant to be copied through the setup scripts, which generate APP_KEY and FRONT_API_SECRET automatically.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
FRONT_URL=http://localhost
FRONT_API_SECRET=

LOG_CHANNEL=errorlog
LOG_LEVEL=debug

FILESYSTEM_DRIVER=s3
LOCAL_FILESYSTEM_VISIBILITY=private

CACHE_DRIVER=redis

QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

# Mail configuration
# For production, set MAIL_MAILER to one of: ses, mailgun, postmark, smtp
# - ses:     Set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION
# - mailgun: Set MAILGUN_DOMAIN, MAILGUN_SECRET, MAILGUN_ENDPOINT
# - postmark: Set POSTMARK_TOKEN
# - smtp:    Set MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_ENCRYPTION
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_your_resend_api_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sales@sharaforms.com
MAIL_FROM_NAME=SharaForms

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

JWT_TTL=1440
JWT_REMEMBER_TTL=10080
JWT_REFRESH_TTL=20160
JWT_SECRET=
JWT_SKIP_IP_UA_VALIDATION=false
SENTRY_TRACE_QUEUE_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1
PUBLIC_UPLOADS_RATE_LIMIT_PER_MINUTE=30
PUBLIC_UPLOADS_RATE_LIMIT_PER_HOUR=300

OPEN_AI_API_KEY=

H_CAPTCHA_SITE_KEY=
H_CAPTCHA_SECRET_KEY=

RE_CAPTCHA_SITE_KEY=
RE_CAPTCHA_SECRET_KEY=

TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=

SHOW_OFFICIAL_TEMPLATES=true
WEBHOOKS_ALLOW_PRIVATE_URLS=false
ADMIN_EMAILS=
TEMPLATE_EDITOR_EMAILS=
MODERATOR_EMAILS=
HORIZON_ALLOWED_EMAILS=
BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_PATH=backups/database
BACKUP_RETENTION_DAYS=14
BACKUP_COMPRESS=true
BACKUP_SCHEDULE=02:30

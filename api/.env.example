# Self-hosted license management (set on cloud instances only)
STRIPE_PROD_SELF_HOSTED_PRODUCT_ID=
STRIPE_PROD_SELF_HOSTED_PRICING_MONTHLY=
STRIPE_PROD_SELF_HOSTED_PRICING_YEARLY=

STRIPE_TEST_SELF_HOSTED_PRODUCT_ID=
STRIPE_TEST_SELF_HOSTED_PRICING_MONTHLY=
STRIPE_TEST_SELF_HOSTED_PRICING_YEARLY=

LICENSE_API_ENDPOINT=https://api.sharaforms.com
LICENSE_CHECKOUT_SUCCESS_URL=https://sharaforms.com/self-hosted/checkout/success
LICENSE_CHECKOUT_CANCEL_URL=https://sharaforms.com/self-hosted/checkout/canceled
LICENSE_PORTAL_RETURN_URL=https://sharaforms.com/self-hosted/checkout/success

BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_PATH=backups/database
BACKUP_RETENTION_DAYS=14
BACKUP_COMPRESS=true
BACKUP_SCHEDULE=02:30

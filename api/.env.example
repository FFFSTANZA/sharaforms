ADMIN_EMAILS=
MODERATOR_EMAILS=
TEMPLATE_EDITOR_EMAILS=

OPEN_AI_API_KEY=
OPEN_AI_BASE_URI=
OPEN_AI_MODEL_MINI=gpt-5.4-mini
OPEN_AI_MODEL_NANO=gpt-5.4-nano

AI_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_BASE_URI=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_MINI=gemini-2.5-flash
GEMINI_MODEL_NANO=gemini-2.5-flash-lite

GROQ_API_KEY=
GROQ_BASE_URI=https://api.groq.com/openai/v1
GROQ_MODEL_MINI=llama-3.3-70b-versatile
GROQ_MODEL_NANO=llama-3.1-8b-instant

CADDY_SECRET=
CADDY_AUTHORIZED_IPS=


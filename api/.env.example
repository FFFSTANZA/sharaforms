APP_NAME="SharaForms"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=warning
APP_URL=https://sharaforms.com

LOG_CHANNEL=stack
LOG_LEVEL=warning
SENTRY_TRACE_QUEUE_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1

FRONT_URL=https://sharaforms.com
FRONT_API_SECRET=secret

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

FILESYSTEM_DRIVER=r2

BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# For production, MAIL_MAILER should be set to one of: ses, mailgun, postmark, smtp
# - ses (recommended): Set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION
# - mailgun:           Set MAILGUN_DOMAIN, MAILGUN_SECRET, MAILGUN_ENDPOINT
# - postmark:          Set POSTMARK_TOKEN
# - smtp:              Set MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_ENCRYPTION
# Resend (smtp):       Set MAIL_PASSWORD to your Resend API key (see keys.txt). Domain verified: sharaforms.com
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_your_resend_api_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@sharaforms.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=stack

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

POSTMARK_TOKEN=

# Cloudflare R2 (S3-compatible storage) — production file storage
# Set FILESYSTEM_DRIVER=r2 to enable R2; keeps `local` for development.
# Create the API token in Cloudflare dashboard → R2 → Manage R2 API Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=sharaforms
R2_ENDPOINT=https://e204d931f9f06be1b78a23645888f629.r2.cloudflarestorage.com
R2_URL=https://pub-11978858e8584a419c881867346d39e9.r2.dev
R2_USE_PATH_STYLE_ENDPOINT=true
R2_BACKUP_BUCKET=sharaforms-backups

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_TTL=1440
JWT_REMEMBER_TTL=10080
JWT_SECRET=
JWT_REFRESH_TTL=20160
SANCTUM_TOKEN_EXPIRATION=1440
CORS_ALLOWED_ORIGINS=https://sharaforms.com
# Local development only. Keep false in production/Docker deployments.
JWT_SKIP_IP_UA_VALIDATION=false
PUBLIC_UPLOADS_RATE_LIMIT_PER_MINUTE=30
PUBLIC_UPLOADS_RATE_LIMIT_PER_HOUR=300
WEBHOOKS_ALLOW_PRIVATE_URLS=false

DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

DODO_PAYMENTS_PRO_PRODUCT_ID_MONTHLY=
DODO_PAYMENTS_PRO_PRODUCT_ID_YEARLY=
DODO_PAYMENTS_BUSINESS_PRODUCT_ID_MONTHLY=
DODO_PAYMENTS_BUSINESS_PRODUCT_ID_YEARLY=
DODO_PAYMENTS_ENTERPRISE_PRODUCT_ID_MONTHLY=
DODO_PAYMENTS_ENTERPRISE_PRODUCT_ID_YEARLY=

STRIPE_KEY=
STRIPE_SECRET=

H_CAPTCHA_SITE_KEY=
H_CAPTCHA_SECRET_KEY=

RE_CAPTCHA_SITE_KEY=
RE_CAPTCHA_SECRET_KEY=
RE_CAPTCHA_PROJECT_ID=sharaforms
